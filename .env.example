VITE_API_BASE_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws

# Startup splash overlay (set to false to skip boot animation).
# VITE_ENABLE_SPLASH_SCREEN=false

# Optional: provide a complete MapLibre style URL or a raster satellite tile URL.
# VITE_MAP_STYLE_URL=
# VITE_SATELLITE_TILE_URL=

# Optional video source.
# VITE_VIDEO_URL=
# VITE_VIDEO_KIND=mjpeg
