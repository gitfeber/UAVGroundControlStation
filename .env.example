VITE_API_BASE_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws

# Runtime link mode. Unset = the browser dev stack (Node server over the URLs
# above). Set to "webserial" for the Hosted Web App build (pnpm build:cloud):
# a pure browser SPA that reads the serial radio via Web Serial — telemetry
# stays in your browser. MAVLink-only, Chromium + HTTPS only. See docs/adr/0006.
# VITE_LINK=webserial

# Startup splash overlay (set to false to skip boot animation).
# VITE_ENABLE_SPLASH_SCREEN=false

# Optional map overrides (hide the in-app Tactical / Satellite / Topo switcher when
# VITE_MAP_STYLE_URL is set). VITE_SATELLITE_TILE_URL replaces the default Esri
# World Imagery tiles for the Satellite preset only.
# VITE_MAP_STYLE_URL=
# VITE_SATELLITE_TILE_URL=

# Optional video source.
# VITE_VIDEO_URL=
# VITE_VIDEO_KIND=mjpeg
