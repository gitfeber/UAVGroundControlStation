{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UAV Ground Control Station",
  "version": "0.1.1",
  "identifier": "com.uav.ground-control-station",
  "build": {
    "beforeDevCommand": "pnpm --filter @uav-ground-control-station/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @uav-ground-control-station/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "UAV Ground Control Station",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
